{
  "manifest_version": 3,
  "name": "Puffer Party Helper",
  "version": "3.0.2",
  "description": "Standalone Krillion helper with AI suggestions, rarity sorting and Autofill.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://krillion.io/*",
    "https://www.krillion.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Puffer Party Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/puffer-16.png",
      "32": "icons/puffer-32.png",
      "48": "icons/puffer-48.png",
      "128": "icons/puffer-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://krillion.io/*",
        "https://www.krillion.io/*"
      ],
      "js": [
        "reader.js",
        "autoplay.js",
        "grind.js",
        "panel-style.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/puffer-16.png",
    "32": "icons/puffer-32.png",
    "48": "icons/puffer-48.png",
    "128": "icons/puffer-128.png"
  }
}
