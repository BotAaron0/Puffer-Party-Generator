{
  "manifest_version": 3,
  "name": "Puffer Companion",
  "version": "2.2.1",
  "description": "Read Krillion categories and played answers, with AI suggestions from your local Puffer Helper app.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Puffer Companion", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://krillion.io/*", "https://www.krillion.io/*"],
    "js": ["reader.js", "autoplay.js", "panel-style.js", "content.js"],
    "run_at": "document_start"
  }]
}
